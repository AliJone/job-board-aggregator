# Lead enrichment keys. Every line is optional; a missing key just skips that provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
HUNTER_API_KEY=
TOMBA_API_KEY=
TOMBA_SECRET=
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=
BRAVE_API_KEY=
GITHUB_TOKEN=
# Raise a free-tier cap if you buy credits, e.g. CAP_HUNTER=500

# Daily run (scripts/daily_run.py). The evening summary is sent through this SMTP account.
SUMMARY_TO=
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
# Zoho: an app-specific password (Zoho Accounts > Security > App Passwords)
SMTP_PASS=
SMTP_FROM=
SMTP_AUTH=login
DAILY_TZ=Asia/Karachi
# 0 = no cap
DAILY_MAX_JOBS_PER_PROVIDER=1500
# scrape every CYCLE_DAYS, sooner once the email queue is empty, never within CYCLE_MIN_DAYS
CYCLE_DAYS=21
CYCLE_MIN_DAYS=7
# comma list of steps to skip: outreach,topup,scrape,merge,enrich,ingest
DAILY_SKIP_STEPS=
# empty = 40 until the outreach module exists, then 0 (every company)
DAILY_ENRICH_TOP=
DAILY_ENRICH_MIN_SCORE=4
DAILY_ENRICH_PEOPLE=3
DAILY_ENRICH_MIN_CONFIDENCE=70
DAILY_ENRICH_CACHE_DAYS=21
DAILY_ENRICH_MAX_MINUTES=110
DAILY_ENRICH_NO_LLM=0
READY_EMAIL_CONFIDENCE=90
# per-step timeouts in minutes; defaults: outreach 120, topup 30, scrape 300, merge 30, enrich 130, ingest 5
DAILY_SCRAPE_TIMEOUT_MIN=
DAILY_ENRICH_TIMEOUT_MIN=
