# Lead enrichment keys. Every line is optional; a missing key just skips that provider.
OPENROUTER_API_KEY=
# comma list, best first; each call starts at the best model that is not resting. Empty = built-in list
OPENROUTER_MODEL=
HUNTER_API_KEY=
TOMBA_API_KEY=
TOMBA_SECRET=
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=
BRAVE_API_KEY=
GITHUB_TOKEN=
# Raise a free-tier cap if you buy credits, e.g. CAP_HUNTER=500

# Daily run (scripts/daily_run.py). The evening summary is sent through this SMTP account.
SUMMARY_TO=
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
# Zoho: an app-specific password (Zoho Accounts > Security > App Passwords)
SMTP_PASS=
SMTP_FROM=
SMTP_AUTH=login
DAILY_TZ=Asia/Karachi
# 0 = no cap
DAILY_MAX_JOBS_PER_PROVIDER=1500
# scrape every CYCLE_DAYS, sooner once the email queue is empty, never within CYCLE_MIN_DAYS
CYCLE_DAYS=21
CYCLE_MIN_DAYS=7
# comma list of steps to skip: outreach,topup,scrape,merge,enrich,ingest
DAILY_SKIP_STEPS=
# empty = 40 until the outreach module exists, then 0 (every company)
DAILY_ENRICH_TOP=
DAILY_ENRICH_MIN_SCORE=4
DAILY_ENRICH_PEOPLE=3
DAILY_ENRICH_MIN_CONFIDENCE=70
DAILY_ENRICH_CACHE_DAYS=21
DAILY_ENRICH_MAX_MINUTES=110
DAILY_ENRICH_NO_LLM=0
READY_EMAIL_CONFIDENCE=90
# per-step timeouts in minutes; defaults: outreach 120, topup 30, scrape 300, merge 30, enrich 130, ingest 5
DAILY_SCRAPE_TIMEOUT_MIN=
DAILY_ENRICH_TIMEOUT_MIN=

# Outreach (scripts/outreach.py). Sends through the SMTP account above. off = nothing sent, no credits spent;
# review = .eml drafts in scripts/output/drafts/ and credits spent on top-ups; send = real email.
OUTREACH_MODE=off
OUTREACH_MIN_CONFIDENCE=90
# emails per day per inbox: 5 for 7 days, 10 for 7 days, then 20
OUTREACH_WARMUP=5:7,10:7,20
# seconds between sends
OUTREACH_GAP=60-180
OUTREACH_FOLLOWUP_DAYS=7
OUTREACH_COMPANY_COOLDOWN_DAYS=90
# pause an inbox after 3 reported bounces in 7 days, or above this percent once this many were sent
OUTREACH_BOUNCE_PAUSE_PCT=3
OUTREACH_BOUNCE_MIN_SENT=20
OUTREACH_ALLOW_PERSONAL=1
# keep this many days of sends verified ahead
OUTREACH_TOPUP_DAYS=3
# sends only on weekdays in this timezone
OUTREACH_DEFAULT_TZ=America/New_York
# signature lines and the opt-out address (default: the sending inbox)
SENDER_NAME=
AGENCY_NAME=drawnonward
SENDER_ADDRESS_LINE=
UNSUBSCRIBE_ADDRESS=
